{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `DOM` is here only for the WHATWG `TextEncoder` used to measure UTF-8
    // bytes; it exists in both the browser and Node, and this package touches no
    // other platform API.
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "include": ["src/**/*.ts"]
}
