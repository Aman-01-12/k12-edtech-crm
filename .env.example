# =============================================================================
# Environment template
#
# Copy to `.env` in this directory and fill in real values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file is the template
# only: it carries variable names, formats and comments, never a real value.
#
# One file serves both applications. The backend loads it directly; Vite is
# configured with `envDir` pointing here, and exposes only the `VITE_`-prefixed
# variables to the browser bundle.
#
# Every variable without a default is required. The backend validates all of
# them against a schema at startup and refuses to start if one is missing or
# malformed, naming the offending variable, rather than failing later at the
# first request that needs it.
# =============================================================================


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Supabase PostgreSQL connection string.
#
# USE THE CONNECTION POOLER, NOT THE DIRECT ENDPOINT.
#   The direct endpoint, `db.<project-ref>.supabase.co`, publishes only an AAAA
#   record and is therefore IPv6-only unless the project has the IPv4 add-on.
#   Many networks and some serverless runtimes have no IPv6 egress, so the
#   direct endpoint fails there with a connection timeout that looks like a
#   wrong password. The pooler host is dual-stack and works everywhere.
#
# Find it in the Supabase dashboard under Connect. Note that the pooler username
# is `postgres.<project-ref>`, not plain `postgres`.
#
#   Transaction mode, port 6543 - use this for the deployed API.
#     Designed for short-lived serverless connections. Does not support
#     session-level features, which this application does not use.
#
#   Session mode, port 5432 - use this to apply schema.sql and for local runs.
#     A full session, which `psql` and schema application need.
#
# PERCENT-ENCODE THE PASSWORD. This is a connection URI, so any of
# @ : / ? # [ ] in the password must be escaped, or the URI parses wrongly and
# the driver reports a misleading host or authentication error. For example a
# password of `p@ss#1` must be written `p%40ss%231`.
#
# Format:
#   postgresql://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:6543/postgres
DATABASE_URL=

# Maximum connections this process will open. Keep it small: the API runs as a
# serverless function, so many instances may be warm at once and the pooler
# multiplexes them onto far fewer real Postgres backends.
# Default: 5
DATABASE_POOL_MAX=

# Milliseconds to wait for a connection from the pool before failing. Fails fast
# under load rather than queueing requests behind an exhausted pool.
# Default: 5000
DATABASE_CONNECTION_TIMEOUT_MS=

# Milliseconds after which the server cancels a running query. Stops one slow or
# pathological query from holding a connection indefinitely.
# Default: 8000
DATABASE_STATEMENT_TIMEOUT_MS=

# PEM for the database's certificate authority.
#
# REQUIRED FOR SUPABASE. Supabase signs its Postgres certificate with its own
# "Supabase Root 2021 CA", which is self-signed and therefore not in Node's
# default trust store. Without this, a verified connection fails with
# SELF_SIGNED_CERT_IN_CHAIN. Download it from the dashboard under Database
# Settings -> SSL Configuration.
#
# The value is added to Node's bundled roots, not substituted for them, so
# setting it cannot break a provider that does use a publicly trusted
# certificate.
#
# Leave blank only when the database certificate chains to a public CA, which
# is the case for a local Postgres with TLS off.
DATABASE_CA_CERT=

# `true` to stop verifying the database certificate. Encryption still applies,
# but the server's identity is no longer checked, so the connection becomes
# interceptable. It exists only so a deployment is not hard-blocked when the CA
# is unavailable; it must be set deliberately and is logged loudly on every
# startup. See docs/adr/0011-database-tls-verification.md.
# Default: false
DATABASE_SSL_NO_VERIFY=


# -----------------------------------------------------------------------------
# Authentication
#
# Admin authentication is implemented from scratch in this backend: bcrypt
# password hashing, JWT issuance and verification, and protected-route
# middleware. Supabase Auth is deliberately not used.
# -----------------------------------------------------------------------------

# Secret used to sign and verify access-token JWTs with HS256.
#
# Must be at least 32 bytes. The server refuses to start if it is missing or
# shorter, and there is deliberately no fallback or default value: a guessable
# signing key means anyone can mint a valid admin token.
#
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Issuer and audience claims. Set on every token and *required* on every
# verification, so a token minted for another system is rejected even if it was
# signed with the same secret.
# Defaults: k12-edtech-crm / k12-edtech-crm-admin
JWT_ISSUER=
JWT_AUDIENCE=

# Access-token lifetime. Short by design: an access token cannot be revoked, so
# its blast radius is bounded by its expiry. Accepts a duration such as 15m.
# The value reported to the client is derived from this, never hardcoded.
# Default: 15m
ACCESS_TOKEN_TTL=

# Refresh-token lifetime. Refresh tokens are opaque random values stored only as
# a SHA-256 digest, rotated on every use, and revocable, so a longer life here is
# safe in a way it would not be for a JWT.
# Default: 7d
REFRESH_TOKEN_TTL=

# bcrypt cost factor. Must be at least 12. Higher is slower to crack and slower
# to sign in; 12 is roughly 150-250ms per verification on typical hardware.
# Default: 12
BCRYPT_COST=


# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------

# `development`, `test` or `production`. Controls whether session cookies carry
# the `Secure` flag, since local development is served over plain HTTP.
# Default: development
NODE_ENV=

# Port for the local API server. Ignored when deployed as a serverless function.
# Default: 4000
PORT=

# Comma-separated list of browser origins allowed to call the API with
# credentials. An exact allowlist: the request's own origin is never reflected
# back, because that would make the allowlist meaningless.
#
# In production the frontend rewrites /api to this backend, so the browser only
# ever makes same-origin requests and this list matters only for direct API
# access. Keep localhost entries for local development.
# Default: http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Maximum accepted request body size. The public submission endpoint is
# unauthenticated, so an unbounded body is a trivial resource-exhaustion vector.
# Default: 16kb
BODY_LIMIT=

# `fatal` `error` `warn` `info` `debug` or `trace`. Logs are structured JSON with
# credentials and tokens redacted.
# Default: info
LOG_LEVEL=


# -----------------------------------------------------------------------------
# Rate limiting
#
# Counters live in Postgres, not in process memory, because the API runs as a
# serverless function: an in-memory counter would be per-instance, so the
# advertised limit would not be the enforced limit once more than one instance
# is warm.
# -----------------------------------------------------------------------------

# Every limiter is a sliding window, not a fixed one: a fixed window admits
# twice its limit across a window boundary.
#
# "Network" below means the client's IPv4 address or, for IPv6, its /64 prefix.
# Keying an IPv6 limit on the full address would be free to evade, since a
# single customer is routinely handed an entire /64.

# Public inquiry submission, keyed on network. There is no more specific
# identity available on an anonymous endpoint.
# Defaults: 60000 (1 minute) / 5
RATE_LIMIT_SUBMIT_WINDOW_MS=
RATE_LIMIT_SUBMIT_MAX=

# Admin sign-in, limited on two axes at once and consuming allowance only on a
# failed attempt.
#
#   RATE_LIMIT_LOGIN_MAX           failures against one account, which stops
#                                  brute force against a known address.
#   RATE_LIMIT_LOGIN_NETWORK_MAX   failures from one network, which stops
#                                  credential stuffing spread across many
#                                  accounts. Higher, because a school or office
#                                  shares one address.
#
# Both are needed: an attacker evades a per-account limit by spreading across
# accounts, and evades a per-network limit by spreading across networks.
# Defaults: 900000 (15 minutes) / 10 / 50
RATE_LIMIT_LOGIN_WINDOW_MS=
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_NETWORK_MAX=

# Token refresh, keyed on network.
# Defaults: 900000 (15 minutes) / 60
RATE_LIMIT_REFRESH_WINDOW_MS=
RATE_LIMIT_REFRESH_MAX=

# CSV export, keyed on the authenticated admin's id, which is the most specific
# identity available once a caller is known.
# Defaults: 900000 (15 minutes) / 10
RATE_LIMIT_EXPORT_WINDOW_MS=
RATE_LIMIT_EXPORT_MAX=

# Replying to an applicant, keyed on the admin account. Sending mail costs the
# operator money and spends their domain's sending reputation, so a compromised
# session cannot turn the dashboard into a spam cannon.
# Defaults: 3600000 (1 hour) / 60
RATE_LIMIT_REPLY_WINDOW_MS=
RATE_LIMIT_REPLY_MAX=

# Password reset, both steps keyed on network rather than on the submitted
# email. Keying the request step on the email would let an attacker tell a
# rate-limited address from a fresh one, which is the account-existence signal
# the generic response exists to withhold.
# Defaults: 900000 (15 minutes) / 5 and 900000 / 10
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=
RATE_LIMIT_FORGOT_PASSWORD_MAX=
RATE_LIMIT_RESET_PASSWORD_WINDOW_MS=
RATE_LIMIT_RESET_PASSWORD_MAX=


# -----------------------------------------------------------------------------
# Email (password reset)
#
# Required. A password reset is security sensitive, so a half-configured
# deployment refuses to start rather than silently failing to send, or sending
# from an address the recipient's mail server will not trust.
#
# See docs/adr/0013-password-reset-by-email.md.
# -----------------------------------------------------------------------------

# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=

# The From address. Its domain MUST be verified in Resend, or mail is rejected
# or silently spam-filed. Format: Name <address@verified-domain>
RESEND_FROM_EMAIL=

# How long a reset link stays usable. Short by design: the link is a credential
# sitting in an inbox, and it is single-use regardless.
# Default: 1h
PASSWORD_RESET_TOKEN_TTL=

# The public origin of the frontend, used to build the link inside the email.
# Distinct from CORS_ALLOWED_ORIGINS, which is a list and decides which origins
# may call the API; this one is a single URL used to construct a link.
# No default. Example: https://k12.crm.kiomeet.com
APP_BASE_URL=


# -----------------------------------------------------------------------------
# Export
# -----------------------------------------------------------------------------

# Maximum rows one CSV export may contain. The response sets
# `X-Export-Truncated` when the cap is reached, rather than streaming an
# unbounded result set through a serverless function with a duration limit.
# Default: 5000 (maximum 50000)
EXPORT_ROW_LIMIT=


# -----------------------------------------------------------------------------
# Admin provisioning and recovery
#
# Read only by the two operator scripts, never by the running application. Both
# take their input from the environment rather than from command arguments, so
# a password does not land in shell history or in a process listing. Unset them
# once the script has run.
#
# There is no public sign-up, by design.
# -----------------------------------------------------------------------------

# Read by `npm run db:seed`, which creates the first admin account. The password
# is hashed with bcrypt before it touches the database and is never logged.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=

# Read by `npm run db:reset-password`, which replaces one admin's password and
# revokes every active session for that account. This stands in for the
# conventional emailed reset link, which this system cannot offer because it has
# no email provider.
RESET_ADMIN_EMAIL=
RESET_ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# Frontend
#
# Only `VITE_`-prefixed variables reach the browser bundle. Never put a secret
# behind this prefix: everything here is readable by anyone who opens the site.
# -----------------------------------------------------------------------------

# Base path or URL the browser uses for API calls.
#
# Leave as `/api` for both local development and production: Vite proxies /api to
# the local backend, and the deployed frontend rewrites /api to the backend
# deployment. Same-origin in both cases, which is what keeps the session cookies
# first-party and therefore immune to third-party cookie blocking.
# Default: /api
VITE_API_BASE_URL=
